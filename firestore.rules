rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile rules
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Saved places rules
    match /saved_places/{docId} {
      allow read, write: if request.auth != null && (
        docId.matches('^' + request.auth.uid + '_.*') ||
        resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
    }

    // Reviews rules: 3-Star Review System
    match /reviews/{reviewId} {
      // Anyone can read reviews and place ratings
      allow read: if true;

      // Authenticated users can create their own review
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 3;

      // Users can only update their own review
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 3;

      // Users can only delete their own review
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
  }
}
